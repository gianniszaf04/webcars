# User uploads are images only: never run anything from this folder (Apache).
Options -Indexes

<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|html?|svg)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
